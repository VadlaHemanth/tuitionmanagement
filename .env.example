# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Optional 32+ byte secret for HMAC signing session cookies.
# Leave blank in development to use a secure ephemeral per-boot secret.
SESSION_SECRET=""

# TEACHER_ADMIN_PASSCODE: Optional server-side passcode override for teacher sign-in.
# If unset, use the built-in first-run setup wizard to claim your teacher account.
TEACHER_ADMIN_PASSCODE=""

# DB_PATH: Optional SQLite file path for local/Node.js server mode.
DB_PATH="./data/tuitio.db"
